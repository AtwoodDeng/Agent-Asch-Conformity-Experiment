# 复制为 .env 后填写。此文件本身不包含任何真实凭据。
# .env 已在 .gitignore 中，不会被提交。

# ---------------------------------------------------------------------------
# 模型调用（仅 --llm openai 需要；--llm scripted 完全不需要）
# ---------------------------------------------------------------------------
# 每个 provider 槽位读取自己的前缀环境变量（与 tajfel-study 相同的写法）。
# 当前只注册了 "openai"（前缀 SV_LLM_*）；以后新增 provider 时在
# asch/model.py 的 LLM_PROVIDERS 中加一行，并在这里补 SV_LLM<N>_* 三件套。
#
# provider "openai"（--llm openai）
SV_LLM_API_KEY=
# 备选键名；若同时设置，asch/model.py 优先使用 SV_LLM_API_KEY。
OPENAI_API_KEY=

# 模型标识。留空时默认 gpt-4o。
# 注意：主任务强制要求图像输入（实验规划 §3.1），因此这里必须是
# 支持图像的多模态模型，纯文本模型会产生无效作答。
SV_LLM_MODEL=

# 自定义端点（可选）。指向兼容 OpenAI 接口的服务时填写，留空默认官方端点。
# 常见形态：https://<host>/v1
SV_LLM_BASE_URL=

# ---------------------------------------------------------------------------
# 运行参数（可选，覆盖命令行默认值）
# ---------------------------------------------------------------------------
# 温度。从众研究关心的是分布，不建议设为 0。
# ASCH_TEMPERATURE=0.7
# 单次作答的 token 上限。答案只需一个字母，保持小值可避免长篇解释。
# ASCH_MAX_TOKENS=24
# 并发请求数。
# ASCH_MAX_WORKERS=4

# ---------------------------------------------------------------------------
# 未设置的后果
# ---------------------------------------------------------------------------
# 当 SV_LLM_API_KEY 与 OPENAI_API_KEY 均为空时，--llm openai 会抛出：
#   RuntimeError: no API key for LLM provider 'openai';
#                 set SV_LLM_API_KEY (or OPENAI_API_KEY) in .env,
#                 or run with --llm scripted
# 该行为是刻意的：宁可显式失败，也不要静默回退到盲策略而产生
# 一份看起来正常、实则与模型无关的"结果"。